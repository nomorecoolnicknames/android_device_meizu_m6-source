# init.meizu_m6.nvram.rc — MTK NVRAM (IMEI, RF calibration, Wi-Fi/BT MAC,
# audio parameters) for the Meizu M6 on Android 13.
# Installed as /vendor/etc/init/hw/init.meizu_m6.nvram.rc, imported by
# init.mt6755.rc BEFORE init.meizu_m6.modem.rc.
#
# DRAFT (treble-m6-m6t design lane, 2026-09-25). Not booted yet.
# Tags as in init.mt6755.rc.
#
# Why the modem depends on this file (FACT, blob strings):
#   ccci_mdinit waits for service.nvram_init ("wait service.nvram_init=%s...
#   timeout") and reads /data/nvram/APCFG/APRDCL/MD_SBP; ccci_fsd serves the
#   modem file system out of /data/nvram/md and /data/nvram/md3;
#   nvram_daemon is the one that sets service.nvram_init.
#   m95 on A13: while NVRAM never became Ready, audio, ccci_mdinit, GPS and
#   MAL all waited and the watchdog killed system_server in a loop
#   [CONV m95:init.mt6797.rc:124-132].
#
# Layout choice. libnvram (lib and lib64) works on /data/nvram/* and also
# knows /nvdata/* (blob:lib64/libnvram.so strings). On this device /nvdata is a
# real partition (by-name/nvdata -> mmcblk0p6, 32 MiB, live:03-partitions),
# and it is where the calibrated records live:
#   - stock:   symlink /nvdata /data/nvram      (stock:init.mt6755.rc:159-165)
#   - los16:   bind-mount /nvdata over /data/nvram (los16:init.nvdata.rc:1-48),
#              because a symlink cannot replace an existing directory
#              (comment at los16:init.nvdata.rc:9-11). That build had working
#              dual-SIM telephony on REDACTED_UNIT.
#   - m95:     plain mkdir /data/nvram, restored from the raw nvram partition.
# The los16 bind mount is taken: same data as stock, proven on this handset,
# and it does not depend on /data/nvram being absent.

on post-fs-data
    # [DEV stock:init.mt6755.rc:159-160, los16:init.nvdata.rc:5-7]
    chown root system /nvdata
    chmod 0771 /nvdata
    restorecon_recursive /nvdata

    # [DEV los16:init.nvdata.rc:16-19]
    mkdir /data/nvram 0771 root system
    mount none /nvdata /data/nvram bind
    chown root system /data/nvram
    chmod 0771 /data/nvram

    # libnvram parses /data/nvram/fstab.${ro.hardware} to find the raw /nvram
    # partition (blob:lib64/libnvram.so: "/data/nvram/fstab.%s", "ro.hardware",
    # fs_mgr_read_fstab, "failed to read fstab"). Stock/los16 copied it from
    # the ramdisk root (/fstab.mt6755); on A13 that copy is gone after
    # switch_root, so it comes from /vendor/etc — m95 lost NVRAM exactly here
    # [CONV m95:init.mt6797.rc:124-133]. The file lands on the nvdata
    # partition through the bind mount, as on los16 (los16:init.nvdata.rc:12-23).
    copy /vendor/etc/fstab.mt6755 /data/nvram/fstab.mt6755
    chown root root /data/nvram/fstab.mt6755
    chmod 0644 /data/nvram/fstab.mt6755

    # Audio calibration records are read from audioserver (group media).
    # [DEV los16:init.nvdata.rc:25-35; stock:init.mt6755.rc:162
    #  "mkdir /nvdata/media 0771 media audio"]
    mkdir /data/nvram/media 0770 root media
    mkdir /data/nvram/APCFG 0771 root system
    mkdir /data/nvram/APCFG/APRDCL 0771 root system
    mkdir /data/nvram/APCFG/APRDEB 0771 root system
    restorecon_recursive /data/nvram

# [DEV stock:init.mt6755.rc:918-922; los16:init.mt6755.rc:1207-1211]
# 32-bit blob (/system/bin/linker interpreter). Sets service.nvram_init=Ready.
service nvram_daemon /vendor/bin/nvram_daemon
    class main
    user root
    group system
    oneshot

# [DEV stock:init.mt6755.rc:1406-1409; live:00-getprop init.svc.NvRAMAgent
# running] Registers the "NvRAMAgent" binder service used by the Flyme/MTK
# apps and some HALs. On A13 it talks to the framework servicemanager from a
# vendor process — works only while SELinux is permissive (INSTALL.txt).
service NvRAMAgent /vendor/bin/nvram_agent_binder
    class main
    user system
    group system
